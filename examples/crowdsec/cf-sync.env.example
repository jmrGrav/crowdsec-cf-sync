# /etc/crowdsec/cf-sync.env — environment file for crowdsec-cf-sync and crowdsec-notifier
# Never commit this file with real values — keep in /etc/crowdsec/ with mode 600

# Cloudflare
CF_API_TOKEN=your_cloudflare_api_token_here
CF_ZONE_ID=your_cloudflare_zone_id_here

# CrowdSec LAPI
CS_API_KEY=your_crowdsec_api_key_here

# AbuseIPDB
ABUSEIPDB_KEY=your_abuseipdb_key_here

# BetterStack telemetry (optional)
BETTERSTACK_TOKEN=your_betterstack_token_here
BETTERSTACK_INGEST=https://in.logs.betterstack.com

# crowdsec-cf-sync behavior flags
CF_DRY_RUN=0                 # Set to 1 to test without writing to Cloudflare
CF_NOTIFIER_ACTIVE=1         # When 1, notifier handles new bans; supervisor keeps expiry/reconcile
SYNC_ABUSEIPDB=0             # When 0, notifier handles AbuseIPDB (disables supervisor's channel)

# crowdsec-notifier behavior flags
# NOTIFIER_DRY_RUN=1         # Uncomment to shadow-log AbuseIPDB reports without sending
# NOTIFIER_CF_DRY_RUN=1      # Uncomment to shadow-log CF blocks without pushing
